{
  "manifest_version": 3,
  "name": "Bionic Reading Extension",
  "version": "3.0",
  "description": "Enhance your reading experience with Bionic Reading, now with Dark Mode",
  "icons": {
    "48": "icon.png"
  },
  "permissions": ["activeTab", "storage"],
  "action": {
    "default_icon": "icon.png",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://fonts.googleapis.com https://fonts.gstatic.com;" 
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/main.js", "content/font.js", "content/bionic.js"]
    }
  ],
  "host_permissions": ["*://*/*"]
}